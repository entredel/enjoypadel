  const originalTextNodes = new WeakMap();

  function normalizeText(text) {
    return text.replace(/\s+/g, " ").trim();
  }

  function preserveSpacing(originalValue, newText) {
    const leading = originalValue.match(/^\s*/)?.[0] || "";
    const trailing = originalValue.match(/\s*$/)?.[0] || "";
    return leading + newText + trailing;
  }

  function getAllTextNodes() {
    const walker = document.createTreeWalker(
      document.body,
      NodeFilter.SHOW_TEXT,
      {
        acceptNode(node) {
          const parent = node.parentElement;
          if (!parent) return NodeFilter.FILTER_REJECT;

          const tag = parent.tagName.toLowerCase();
          if (["script", "style", "noscript"].includes(tag)) {
            return NodeFilter.FILTER_REJECT;
          }

          if (!normalizeText(node.nodeValue)) {
            return NodeFilter.FILTER_REJECT;
          }

          return NodeFilter.FILTER_ACCEPT;
        }
      }
    );

    const nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);
    return nodes;
  }

  function rememberOriginalTexts() {
    getAllTextNodes().forEach((node) => {
      if (!originalTextNodes.has(node)) {
        originalTextNodes.set(node, normalizeText(node.nodeValue));
      }
    });
  }

  function applyLanguage(lang) {
    rememberOriginalTexts();

    document.documentElement.lang = lang === "tr" ? "tr" : lang;

    if (lang === "tr") {
      getAllTextNodes().forEach((node) => {
        const original = originalTextNodes.get(node);
        if (original) node.nodeValue = preserveSpacing(node.nodeValue, original);
      });

      document.title =
        "enjoypadel | Padel & Tenis File İçi Telefon Kayıt Aparatı";

      const metaDescription = document.querySelector('meta[name="description"]');
      if (metaDescription) {
        metaDescription.setAttribute(
          "content",
          "Padel ve tenis maçlarınızı kolayca kaydedin! Can Ertuğrul & Can Özdoğan ortaklığında geliştirilen enjoypadel 3D baskı PETG dayanıklı, fileye takılan telefon tutucu."
        );
      }

      updateSwitcherLabels("tr");
      return;
    }

    const dictionary = translations[lang];

    getAllTextNodes().forEach((node) => {
      const original = originalTextNodes.get(node);
      if (!original) return;

      if (dictionary[original]) {
        node.nodeValue = preserveSpacing(node.nodeValue, dictionary[original]);
      }
    });

    if (dictionary[document.title]) {
      document.title = dictionary[document.title];
    } else if (
      document.title ===
      "enjoypadel | Padel & Tenis File İçi Telefon Kayıt Aparatı"
    ) {
      document.title =
        dictionary[
          "enjoypadel | Padel & Tenis File İçi Telefon Kayıt Aparatı"
        ];
    }

    const metaDescription = document.querySelector('meta[name="description"]');
    if (metaDescription) {
      const originalMeta =
        "Padel ve tenis maçlarınızı kolayca kaydedin! Can Ertuğrul & Can Özdoğan ortaklığında geliştirilen enjoypadel 3D baskı PETG dayanıklı, fileye takılan telefon tutucu.";
      metaDescription.setAttribute("content", dictionary[originalMeta]);
    }

    updateSwitcherLabels(lang);
  }

  function createLanguageSwitcher(type = "desktop") {
    const wrapper = document.createElement("div");
    wrapper.className =
      type === "desktop"
        ? "relative language-switcher"
        : "relative language-switcher mx-auto w-full max-w-xs";

    wrapper.innerHTML = `
      <button
        type="button"
        class="lang-toggle flex items-center justify-center gap-2 rounded-full border border-neutral-800 bg-neutral-900/80 px-4 py-2 text-xs font-bold uppercase tracking-wider text-neutral-300 shadow-lg shadow-black/20 transition hover:border-brandSecondary/60 hover:text-brandSecondary"
        aria-label="Change language"
      >
        <span class="lang-current">TR</span>
        <span class="text-[10px]">▾</span>
      </button>

      <div
        class="lang-dropdown hidden absolute right-0 mt-2 w-36 overflow-hidden rounded-xl border border-neutral-800 bg-neutral-950/95 text-left shadow-2xl shadow-black/40 backdrop-blur-md z-[999]"
      >
        <button type="button" data-lang="tr" class="lang-option block w-full px-4 py-3 text-left text-xs font-semibold text-neutral-300 transition hover:bg-neutral-900 hover:text-brandSecondary">
          Türkçe
        </button>
        <button type="button" data-lang="en" class="lang-option block w-full px-4 py-3 text-left text-xs font-semibold text-neutral-300 transition hover:bg-neutral-900 hover:text-brandSecondary">
          English
        </button>
        <button type="button" data-lang="de" class="lang-option block w-full px-4 py-3 text-left text-xs font-semibold text-neutral-300 transition hover:bg-neutral-900 hover:text-brandSecondary">
          Deutsch
        </button>
      </div>
    `;

    const toggle = wrapper.querySelector(".lang-toggle");
    const dropdown = wrapper.querySelector(".lang-dropdown");

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();

      document.querySelectorAll(".lang-dropdown").forEach((menu) => {
        if (menu !== dropdown) menu.classList.add("hidden");
      });

      dropdown.classList.toggle("hidden");
    });

    wrapper.querySelectorAll(".lang-option").forEach((button) => {
      button.addEventListener("click", () => {
        const selectedLang = button.dataset.lang;
        localStorage.setItem(STORAGE_KEY, selectedLang);
        applyLanguage(selectedLang);

        document.querySelectorAll(".lang-dropdown").forEach((menu) => {
          menu.classList.add("hidden");
        });
      });
    });

    return wrapper;
  }

  function injectLanguageSwitchers() {
    if (document.querySelector(".language-switcher")) return;

    const desktopCta = document.querySelector(
      "header .hidden.items-center.space-x-4"
    );

    if (desktopCta) {
      desktopCta.prepend(createLanguageSwitcher("desktop"));
    }

    const mobileNav = document.querySelector("#mobile-menu nav");

    if (mobileNav) {
      const mobileWrapper = createLanguageSwitcher("mobile");
      mobileWrapper.classList.add("mb-2");

      const dropdown = mobileWrapper.querySelector(".lang-dropdown");
      dropdown.classList.remove("right-0");
      dropdown.classList.add("left-1/2", "-translate-x-1/2");

      mobileNav.prepend(mobileWrapper);
    }
  }

  function updateSwitcherLabels(lang) {
    const label = lang === "en" ? "EN" : lang === "de" ? "DE" : "TR";

    document.querySelectorAll(".lang-current").forEach((element) => {
      element.textContent = label;
    });

    document.querySelectorAll(".lang-option").forEach((button) => {
      const isActive = button.dataset.lang === lang;
      button.classList.toggle("text-brandSecondary", isActive);
      button.classList.toggle("bg-neutral-900", isActive);
    });
  }

  document.addEventListener("click", () => {
    document.querySelectorAll(".lang-dropdown").forEach((menu) => {
      menu.classList.add("hidden");
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    rememberOriginalTexts();
    injectLanguageSwitchers();

    const savedLanguage = localStorage.getItem(STORAGE_KEY) || "tr";
    applyLanguage(savedLanguage);
  });
})();
